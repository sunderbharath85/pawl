{
  "name": "pawl-vscode",
  "displayName": "Pawl for VS Code",
  "description": "A dog (or cat, bird, robot) that watches and drives your coding agents through the Pawl hub.",
  "version": "0.2.0",
  "publisher": "pawl",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "acp",
    "agent",
    "pet",
    "claude",
    "codex"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:pawl.petPanel"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pawl.startSession",
        "title": "Start Session",
        "category": "Pawl",
        "icon": "$(add)"
      },
      {
        "command": "pawl.promptSession",
        "title": "Prompt Session",
        "category": "Pawl",
        "icon": "$(comment)"
      },
      {
        "command": "pawl.cancelSession",
        "title": "Cancel Session",
        "category": "Pawl",
        "icon": "$(debug-stop)"
      },
      {
        "command": "pawl.approvePending",
        "title": "Approve Pending",
        "category": "Pawl",
        "icon": "$(check)"
      },
      {
        "command": "pawl.denyPending",
        "title": "Deny Pending",
        "category": "Pawl",
        "icon": "$(close)"
      },
      {
        "command": "pawl.showPet",
        "title": "Show Pet",
        "category": "Pawl"
      },
      {
        "command": "pawl.openPetPanel",
        "title": "Open Pet in Editor",
        "category": "Pawl",
        "icon": "$(open-preview)"
      },
      {
        "command": "pawl.changeSpecies",
        "title": "Change Pet Species",
        "category": "Pawl",
        "icon": "$(symbol-color)"
      },
      {
        "command": "pawl.renamePet",
        "title": "Rename Pet",
        "category": "Pawl",
        "icon": "$(edit)"
      },
      {
        "command": "pawl.installHooks",
        "title": "Install Agent Hooks",
        "category": "Pawl"
      },
      {
        "command": "pawl.startHub",
        "title": "Start Hub",
        "category": "Pawl",
        "icon": "$(play)"
      },
      {
        "command": "pawl.reconnect",
        "title": "Reconnect to Hub",
        "category": "Pawl",
        "icon": "$(refresh)"
      },
      {
        "command": "pawl.renameMachine",
        "title": "Rename This Machine",
        "category": "Pawl",
        "icon": "$(device-desktop)"
      },
      {
        "command": "pawl.showMachines",
        "title": "Show Machines",
        "category": "Pawl",
        "icon": "$(remote-explorer)"
      },
      {
        "command": "pawl.openSettings",
        "title": "Open Settings",
        "category": "Pawl",
        "icon": "$(settings-gear)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pawl",
          "title": "Pawl",
          "icon": "media/pet.svg"
        }
      ]
    },
    "views": {
      "pawl": [
        {
          "type": "webview",
          "id": "pawl.petView",
          "name": "Pet",
          "icon": "media/pet.svg",
          "contextualTitle": "Pawl"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "pawl.startSession",
          "when": "view == pawl.petView",
          "group": "navigation@1"
        },
        {
          "command": "pawl.openPetPanel",
          "when": "view == pawl.petView",
          "group": "navigation@2"
        },
        {
          "command": "pawl.renamePet",
          "when": "view == pawl.petView",
          "group": "1_pet@0"
        },
        {
          "command": "pawl.changeSpecies",
          "when": "view == pawl.petView",
          "group": "1_pet@1"
        },
        {
          "command": "pawl.installHooks",
          "when": "view == pawl.petView",
          "group": "1_pet@2"
        },
        {
          "command": "pawl.reconnect",
          "when": "view == pawl.petView",
          "group": "1_pet@3"
        },
        {
          "command": "pawl.renameMachine",
          "when": "view == pawl.petView",
          "group": "1_pet@4"
        },
        {
          "command": "pawl.showMachines",
          "when": "view == pawl.petView",
          "group": "1_pet@5"
        },
        {
          "command": "pawl.openSettings",
          "when": "view == pawl.petView",
          "group": "1_pet@6"
        }
      ],
      "commandPalette": [
        {
          "command": "pawl.approvePending",
          "when": "pawl.hasPending"
        },
        {
          "command": "pawl.denyPending",
          "when": "pawl.hasPending"
        }
      ]
    },
    "configuration": {
      "title": "Pawl",
      "properties": {
        "pawl.hubUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "WebSocket URL of the Pawl hub. Empty = `PAWL_HUB_URL` env var, else `ws://127.0.0.1:47800/ws`."
        },
        "pawl.hubToken": {
          "type": "string",
          "default": "",
          "markdownDescription": "Hub token override. Empty = `PAWL_HUB_TOKEN` env var, else the `token` file in the hub data dir. Prefer leaving this empty."
        },
        "pawl.hubExecutable": {
          "type": "string",
          "default": "pawl",
          "markdownDescription": "Command used for **Pawl: Start Hub** and **Pawl: Install Agent Hooks** (`pawl` on PATH by default)."
        },
        "pawl.openEditedFiles": {
          "type": "string",
          "enum": [
            "off",
            "open",
            "diff"
          ],
          "enumDescriptions": [
            "Do nothing when an agent edits a file.",
            "Open the edited file (preview tab, focus stays where it is).",
            "Open a diff of the edited file against git HEAD."
          ],
          "default": "open",
          "markdownDescription": "What to do when an agent edits a file inside this workspace."
        },
        "pawl.notifications": {
          "type": "string",
          "enum": [
            "all",
            "permissions",
            "off"
          ],
          "enumDescriptions": [
            "Permission requests (with Approve/Deny), finished turns and hub notifications.",
            "Only permission requests (with Approve/Deny).",
            "No notifications; the status bar and pet view still update."
          ],
          "default": "all",
          "markdownDescription": "Which events show a VS Code notification."
        },
        "pawl.notifyOnlyWorkspaceSessions": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Only notify for sessions whose working directory is inside this workspace."
        },
        "pawl.defaultAgent": {
          "type": "string",
          "default": "",
          "markdownDescription": "Agent id preselected by **Pawl: Start Session** (e.g. `claude-code`). Empty = last used."
        }
      }
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "watch": "bun run scripts/build.ts --watch",
    "typecheck": "tsc --noEmit -p .",
    "package": "bun run build && bunx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@pawl/hub-client": "workspace:*",
    "@pawl/pet-engine": "workspace:*",
    "@pawl/protocol": "workspace:*",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "~1.100.0",
    "@types/ws": "^8.18.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.23.0"
  }
}
