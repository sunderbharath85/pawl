{
  "name": "krypto-vscode",
  "displayName": "Krypto for VS Code",
  "description": "A dog (or cat, bird, robot) that watches and drives your coding agents through the Krypto hub.",
  "version": "0.1.0",
  "publisher": "krypto",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "acp",
    "agent",
    "pet",
    "claude",
    "codex"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:krypto.petPanel"
  ],
  "contributes": {
    "commands": [
      {
        "command": "krypto.startSession",
        "title": "Start Session",
        "category": "Krypto",
        "icon": "$(add)"
      },
      {
        "command": "krypto.promptSession",
        "title": "Prompt Session",
        "category": "Krypto",
        "icon": "$(comment)"
      },
      {
        "command": "krypto.cancelSession",
        "title": "Cancel Session",
        "category": "Krypto",
        "icon": "$(debug-stop)"
      },
      {
        "command": "krypto.approvePending",
        "title": "Approve Pending",
        "category": "Krypto",
        "icon": "$(check)"
      },
      {
        "command": "krypto.denyPending",
        "title": "Deny Pending",
        "category": "Krypto",
        "icon": "$(close)"
      },
      {
        "command": "krypto.showPet",
        "title": "Show Pet",
        "category": "Krypto"
      },
      {
        "command": "krypto.openPetPanel",
        "title": "Open Pet in Editor",
        "category": "Krypto",
        "icon": "$(open-preview)"
      },
      {
        "command": "krypto.changeSpecies",
        "title": "Change Pet Species",
        "category": "Krypto",
        "icon": "$(symbol-color)"
      },
      {
        "command": "krypto.renamePet",
        "title": "Rename Pet",
        "category": "Krypto",
        "icon": "$(edit)"
      },
      {
        "command": "krypto.installHooks",
        "title": "Install Agent Hooks",
        "category": "Krypto"
      },
      {
        "command": "krypto.startHub",
        "title": "Start Hub",
        "category": "Krypto",
        "icon": "$(play)"
      },
      {
        "command": "krypto.reconnect",
        "title": "Reconnect to Hub",
        "category": "Krypto",
        "icon": "$(refresh)"
      },
      {
        "command": "krypto.renameMachine",
        "title": "Rename This Machine",
        "category": "Krypto",
        "icon": "$(device-desktop)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "krypto",
          "title": "Krypto",
          "icon": "media/pet.svg"
        }
      ]
    },
    "views": {
      "krypto": [
        {
          "type": "webview",
          "id": "krypto.petView",
          "name": "Pet",
          "icon": "media/pet.svg",
          "contextualTitle": "Krypto"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "krypto.startSession",
          "when": "view == krypto.petView",
          "group": "navigation@1"
        },
        {
          "command": "krypto.openPetPanel",
          "when": "view == krypto.petView",
          "group": "navigation@2"
        },
        {
          "command": "krypto.renamePet",
          "when": "view == krypto.petView",
          "group": "1_pet@0"
        },
        {
          "command": "krypto.changeSpecies",
          "when": "view == krypto.petView",
          "group": "1_pet@1"
        },
        {
          "command": "krypto.installHooks",
          "when": "view == krypto.petView",
          "group": "1_pet@2"
        },
        {
          "command": "krypto.reconnect",
          "when": "view == krypto.petView",
          "group": "1_pet@3"
        },
        {
          "command": "krypto.renameMachine",
          "when": "view == krypto.petView",
          "group": "1_pet@4"
        }
      ],
      "commandPalette": [
        {
          "command": "krypto.approvePending",
          "when": "krypto.hasPending"
        },
        {
          "command": "krypto.denyPending",
          "when": "krypto.hasPending"
        }
      ]
    },
    "configuration": {
      "title": "Krypto",
      "properties": {
        "krypto.hubUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "WebSocket URL of the Krypto hub. Empty = `KRYPTO_HUB_URL` env var, else `ws://127.0.0.1:47800/ws`."
        },
        "krypto.hubToken": {
          "type": "string",
          "default": "",
          "markdownDescription": "Hub token override. Empty = `KRYPTO_HUB_TOKEN` env var, else the `token` file in the hub data dir. Prefer leaving this empty."
        },
        "krypto.hubExecutable": {
          "type": "string",
          "default": "krypto",
          "markdownDescription": "Command used for **Krypto: Start Hub** and **Krypto: Install Agent Hooks** (`krypto` on PATH by default)."
        },
        "krypto.openEditedFiles": {
          "type": "string",
          "enum": [
            "off",
            "open",
            "diff"
          ],
          "enumDescriptions": [
            "Do nothing when an agent edits a file.",
            "Open the edited file (preview tab, focus stays where it is).",
            "Open a diff of the edited file against git HEAD."
          ],
          "default": "open",
          "markdownDescription": "What to do when an agent edits a file inside this workspace."
        },
        "krypto.notifications": {
          "type": "string",
          "enum": [
            "all",
            "permissions",
            "off"
          ],
          "enumDescriptions": [
            "Permission requests (with Approve/Deny), finished turns and hub notifications.",
            "Only permission requests (with Approve/Deny).",
            "No notifications; the status bar and pet view still update."
          ],
          "default": "all",
          "markdownDescription": "Which events show a VS Code notification."
        },
        "krypto.notifyOnlyWorkspaceSessions": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Only notify for sessions whose working directory is inside this workspace."
        },
        "krypto.defaultAgent": {
          "type": "string",
          "default": "",
          "markdownDescription": "Agent id preselected by **Krypto: Start Session** (e.g. `claude-code`). Empty = last used."
        }
      }
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "watch": "bun run scripts/build.ts --watch",
    "typecheck": "tsc --noEmit -p .",
    "package": "bun run build && bunx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@krypto/hub-client": "workspace:*",
    "@krypto/pet-engine": "workspace:*",
    "@krypto/protocol": "workspace:*",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "~1.100.0",
    "@types/ws": "^8.18.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.23.0"
  }
}
